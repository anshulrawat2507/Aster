# Dashboard works without credentials. Voice calls require all three values below.
CLINIC_TIMEZONE=Asia/Kolkata
DATABASE_PATH=data/clinic.sqlite3

# Keep these values in .env, never in browser code or Git.
ELEVENLABS_API_KEY=
# Use a voice that your ElevenLabs account can generate through the API.
ELEVENLABS_VOICE_ID=
GOOGLE_API_KEY=
# Check model access/quota for your Google project before calling.
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICE_MAX_CALL_SECONDS=600
VOICE_MAX_SESSIONS=2
